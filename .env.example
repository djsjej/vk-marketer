# =============================================================================
# vk-marketer environment configuration
# =============================================================================
# Скопируй этот файл в .env и заполни значения.
# В Railway эти переменные настраиваются в Settings → Variables.
# НИКОГДА не коммить .env в git.
# =============================================================================

# --- Telegram Bot ---
# Получить у @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Твой Telegram user_id — узнать через @userinfobot
# Только этот пользователь сможет управлять ботом
TELEGRAM_OWNER_ID=

# --- VK Реклама ---
# ОПЦИЯ A (предпочтительная) — OAuth: бот сам генерит и обновляет access_token
# Получить в кабинете VK Рекламы → Настройки → Доступ к API → Запросить доступ
# client_secret показывается только один раз — сохрани сразу!
VK_ADS_OAUTH_CLIENT_ID=
VK_ADS_OAUTH_CLIENT_SECRET=

# ОПЦИЯ B (legacy) — готовый access_token (если уже есть, без OAuth)
# Если задан и не равен "placeholder" — используется напрямую
VK_ADS_TOKEN=placeholder

# Account ID кабинета VK Рекламы (видно в Настройках → Общие)
VK_ADS_ACCOUNT_ID=

# VK ID сообщества для рекламы (ad_object_id) — куда вести трафик
# Это число из URL сообщества (после /club или из настроек кабинета)
# Без него /status работает, но создание кампаний — нет
VK_COMMUNITY_URL_ID=

# Если работаешь как агентство — ID клиентского кабинета (опционально)
# VK_ADS_AGENCY_CLIENT_ID=

# --- Anthropic (Claude API) ---
# Получить на console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Какую модель использовать для анализа и копирайтинга
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
# Локально — SQLite в файле. На Railway после апгрейда — Postgres URL
DATABASE_URL=sqlite:///./data/vk_marketer.db

# --- Safety / Budget Rules ---
# Максимальный расход в день (рубли). При превышении — автостоп всего
MAX_DAILY_SPEND_RUB=2000

# Максимальный расход на одну тестовую кампанию (рубли)
TEST_CAMPAIGN_BUDGET_RUB=200

# Если кампания спустила X рублей за час без кликов — пауза
HOURLY_NO_CLICK_THRESHOLD_RUB=300

# Лимит, выше которого бот всегда спрашивает подтверждение
AUTO_LAUNCH_LIMIT_RUB=500

# --- Schedule ---
# Когда слать утренний отчёт (часы:минуты, по часовому поясу TZ ниже)
MORNING_REPORT_TIME=09:00

# Часовой пояс (IANA tz)
TZ=Europe/Moscow

# Как часто проверять метрики (минуты)
METRICS_CHECK_INTERVAL_MIN=15

# --- Logging ---
LOG_LEVEL=INFO
